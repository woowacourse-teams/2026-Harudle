{
  "expo": {
    "name": "하루들",
    "slug": "harudle",
    "icon": "./assets/icon.png",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-apple-authentication",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "하루들 이미지를 사진첩에 저장하기 위해 권한이 필요해요.",
          "granularPermissions": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 180,
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.harudle.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.harudle.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#CDB9F7"
      }
    }
  }
}
