# 서버의 /opt/harudle-event/.env.event 로 복사해 채운다. 권한 600.
GOOGLE_APPLICATION_CREDENTIALS=/var/run/harudle/gcp-wif.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

EVENT_STORYBOARD_MODEL=gemini-3.5-flash
EVENT_STORYBOARD_THINKING_LEVEL=medium
# 2K(1696x2528)로 바로 받아 4x6 300dpi 출력에 쓴다. nano-banana-2.1은 imageSize를 무시한다.
EVENT_IMAGE_MODEL=gemini-3.1-flash-image
EVENT_IMAGE_SIZE=2K

# 동시 생성 수와 대기열 상한. 대기열이 가득 차면 503으로 거절한다.
EVENT_CONCURRENCY=1
EVENT_MAX_QUEUE=20
# IP당 시간당 횟수. 부스 기기는 같은 IP를 공유하므로 0(끔)으로 두고 Nginx 화이트리스트로 막는다.
EVENT_RATE_LIMIT_PER_HOUR=0
# 하루 전체 상한(한국 시간 자정 초기화). 0이면 제한 없음.
EVENT_DAILY_LIMIT=300
# 값이 있으면 ?code= 로 같은 값을 보낸 요청만 받는다. 행사장 QR 주소에 넣는다.
EVENT_ACCESS_CODE=
# 완성 이미지 보관 시간
EVENT_RESULT_TTL_MINUTES=120

# 부스 운영: 입력 기기 여러 대 + 프린터 기기 1대. 완성 엽서를 인쇄 대기열로 보내 /print 화면이 자동 인쇄한다.
EVENT_PRINT_QUEUE=true
# 인쇄 화면 접속 키(선택, 12자 이상). 비워 두면 키 없이 /print 를 쓰고, 접근은 Host Nginx IP 화이트리스트로 막는다.
# 값을 넣으면 프린터 기기에서 /print?key=<값> 으로 한 번 연다.
EVENT_PRINT_KEY=
# 인쇄 화면이 엽서를 가져간 뒤 완료 보고가 없으면 다시 대기열로 돌리는 시간(초)
EVENT_PRINT_LEASE_SECONDS=120
# 결과 화면을 보여 준 뒤 입력 화면으로 자동으로 돌아가는 시간(초). 실패 화면은 3배.
EVENT_RESULT_RESET_SECONDS=10

# 이미지 대체 생성. openai면 Gemini가 칸 위치 거절·429·시간 초과로 실패했을 때 마지막 시도를 OpenAI로 한다.
# 전체 시도 수(EVENT_IMAGE_ATTEMPTS, 기본 2)는 그대로라 기본값에서는 Gemini 1번 + OpenAI 1번이다.
EVENT_IMAGE_FALLBACK=none
# 서버 파일에만 넣는다. 저장소·로그·채팅에 남기지 않는다.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT_MS=180000

# 스토리보드 대체 생성. openai면 Gemini 스토리보드가 429·시간 초과·JSON 검증 실패로 실패했을 때 두 번째 시도를
# OpenAI(GPT Luna)로 한다. 위 OPENAI_API_KEY를 함께 쓴다. 일기 원문이 전송되며, 입력 화면 안내 문구에 함께 표시된다.
EVENT_STORYBOARD_FALLBACK=none
OPENAI_STORYBOARD_MODEL=gpt-6-luna
# none, low, medium, high, xhigh, max. 높을수록 느리다.
OPENAI_STORYBOARD_REASONING=low
OPENAI_STORYBOARD_TIMEOUT_MS=60000
