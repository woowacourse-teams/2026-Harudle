DB_HOST=localhost
DB_PORT=5432
DB_NAME=harudle
DB_USERNAME=harudle
DB_PASSWORD=

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

JWT_SECRET_BASE64=

# Required: independent random 32-byte Base64 key. Never reuse JWT/test keys.
# Generate once per environment, preserve across deploys, and store outside Git.
DIARY_SOURCE_TEXT_ACTIVE_KEY_ID=primary
DIARY_SOURCE_TEXT_KEY_BASE64=
# Local default allows encrypted new writes. false pauses only new diary creation.
DIARY_SOURCE_TEXT_NEW_WRITES_ENABLED=true
# Required for the prod profile, including dev EC2. Preserve trusted evidence across deploys.
DIARY_SOURCE_TEXT_KEY_VERIFICATION_FILE=

BACKEND_BASE_URL=http://localhost:8080
# Production: https://www.harudle.com,https://harudle.com
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_SUCCESS_REDIRECT=http://localhost:5173/auth/callback
FRONTEND_FAILURE_REDIRECT=http://localhost:5173/auth/callback?error=oauth_failed

# Public feed detail page (production: https://www.harudle.com/feeds)
FEED_PUBLIC_BASE_URL=http://localhost:5173/feeds

SESSION_COOKIE_SECURE=false
REFRESH_COOKIE_SECURE=false

# Guest trial
GUEST_SESSION_TTL=30d
GUEST_COOKIE_SECURE=false

# Admin image recovery (per server instance)
ADMIN_IMAGE_RECOVERY_INTERVAL=10s

# Generation worker (per server instance; restart the backend after changes)
GENERATION_WORKER_CONCURRENCY=1
GENERATION_WORKER_POLL_INTERVAL=5s

# Generation lifecycle
GENERATION_PROCESSING_TIMEOUT=30m
GENERATION_CLEANUP_INTERVAL=1m
# 대기 작업의 제한 시간과 만료 확인 간격입니다.
GENERATION_PENDING_TIMEOUT=120s
GENERATION_PENDING_CLEANUP_INTERVAL=5s

# Generation prompt bootstrap
HARUDLE_GENERATION_PROMPT_BOOTSTRAP_ENABLED=false
HARUDLE_GENERATION_PROMPT_BOOTSTRAP_STORYBOARD_PROMPT_TEXT=
HARUDLE_GENERATION_PROMPT_BOOTSTRAP_IMAGE_STYLE_PROMPT_TEXT=
# Copy and verify this reference file before enabling generation adapters.
HARUDLE_GENERATION_PROMPT_BOOTSTRAP_IMAGE_ASSET_OBJECT_KEY=harudle/references/generation/dev/05-reference-style-asset.png

# External generation adapters
# true일 때 Gemini 이미지 인증, 선택한 스토리보드 Provider 설정과 S3 bucket이 필요합니다.
HARUDLE_GENERATION_ADAPTERS_ENABLED=false

# Storyboard provider: gemini / qwen
STORYBOARD_PROVIDER=gemini
# Storyboard calls use the timeout for their primary/fallback role, with one call per provider.
# none disables fallback; an enabled fallback must differ from the primary provider.
STORYBOARD_FALLBACK_PROVIDER=none
STORYBOARD_PRIMARY_TIMEOUT=60s
STORYBOARD_FALLBACK_TIMEOUT=60s
# Required when qwen is selected as the primary or fallback; use a sk-sp- Token Plan key.
QWEN_TOKEN_PLAN_API_KEY=
QWEN_STORYBOARD_MODEL=qwen3.8-max
QWEN_THINKING_BUDGET=1024
QWEN_MAX_OUTPUT_TOKENS=8192
# Legacy property retained for compatibility; the server uses STORYBOARD_PRIMARY/FALLBACK_TIMEOUT instead.
QWEN_REQUEST_TIMEOUT=180s

# Image fallback: none / codex. Gemini HTTP 429 or timeout switches providers.
# codex disables Gemini image retries; a separate OAuth-authenticated worker is required.
IMAGE_FALLBACK_PROVIDER=none
CODEX_IMAGE_WORKER_URL=
CODEX_IMAGE_WORKER_TOKEN=
CODEX_IMAGE_TIMEOUT=310s

# Gemini authentication: express (API Key) / vertex (project + ADC)
GEMINI_AUTH_MODE=express
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Vertex WIF: 실제 프로세스 환경 변수로 설정합니다. backend/README.md 참고.
# GOOGLE_APPLICATION_CREDENTIALS=/var/run/harudle/gcp-wif.json
GEMINI_STORYBOARD_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Nano Banana 2.1: vertex 모드와 global에서 위 모델 값을 gemini-nano-banana-2.1로 변경합니다.
GEMINI_STORYBOARD_THINKING_LEVEL=high
GEMINI_IMAGE_ASPECT_RATIO=1:1
GEMINI_MAX_OUTPUT_TOKENS=8192
# Image-generation transport settings; retries apply only when the Codex fallback is disabled.
# Storyboard uses its dedicated timeout and no internal retries.
GEMINI_RETRY_ATTEMPTS=3
GEMINI_REQUEST_TIMEOUT=180s

# AWS credentials for local development
# IAM role or AWS profile을 사용하면 아래 credential 변수는 삭제할 수 있습니다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

PROFILE_IMAGE_BASE_URL=http://localhost:5173/profile-images/v1

# S3
AWS_REGION=ap-northeast-2
S3_BUCKET=
DEPLOY_ENV=dev
S3_GENERATED_PREFIX=harudle/generated/diary-images/dev
S3_REFERENCE_PREFIX=harudle/references/generation/dev
S3_MAX_OBJECT_SIZE=20MB
S3_ACCESS_URL_TTL=15m

# R2 storage (dev tests may use development credentials; keep production credentials out of dev)
R2_ENABLED=false
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCESS_URL_TTL=15m
R2_MAX_OBJECT_SIZE=20MB
R2_LIST_LOOKUP_BUDGET=2s
R2_SINGLE_LOOKUP_BUDGET=2s
# Automatic backup: enable only on prod after storage configuration is verified.
R2_BACKUP_SCHEDULER_ENABLED=false
R2_BACKUP_CRON=0 0 0 * * *
R2_BACKUP_ZONE=Asia/Seoul
R2_BACKUP_BATCH_SIZE=100

# API documentation
HARUDLE_API_DOCUMENTATION_ENABLED=true

# Feed push
HARUDLE_PUSH_FCM_ENABLED=false
FIREBASE_PROJECT_ID=harudle-2ef80
