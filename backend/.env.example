# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=harudle
DB_USERNAME=harudle
DB_PASSWORD=

# Generation lifecycle
GENERATION_PROCESSING_TIMEOUT=30m
GENERATION_CLEANUP_INTERVAL=1m

# Gemini - Vertex AI Express Mode
GOOGLE_API_KEY=
GEMINI_STORYBOARD_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_STORYBOARD_THINKING_LEVEL=high
GEMINI_IMAGE_ASPECT_RATIO=1:1
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_RETRY_ATTEMPTS=3
GEMINI_REQUEST_TIMEOUT=180s

# AWS credentials for local development
# IAM role or AWS profile을 사용하면 아래 credential 변수는 삭제할 수 있습니다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# S3
AWS_REGION=ap-northeast-2
S3_BUCKET=
S3_GENERATED_PREFIX=generated/diary-images
S3_MAX_OBJECT_SIZE=20MB
