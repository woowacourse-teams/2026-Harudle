{
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": {
        "measurement": [{"name": "used_percent", "unit": "Percent"}],
        "metrics_collection_interval": 60
      },
      "disk": {
        "resources": ["/"],
        "measurement": [{"name": "used_percent", "unit": "Percent"}],
        "drop_device": true,
        "metrics_collection_interval": 60
      }
    }
  }
}
