# Docker Compose
APP_PORT=3000
# CodeDeploy target: harudle-prod. Dev must use dev and matching dev paths below.
DEPLOY_ENV=prod

SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# External RDS
DB_HOST=replace-with-rds-endpoint.ap-northeast-2.rds.amazonaws.com
DB_PORT=5432
DB_NAME=harudle_prod
DB_USERNAME=harudle_prod
DB_PASSWORD=replace-with-a-secret
# Limit each lock wait in blocking, contact writes and feed publication; transaction-local only.
INTERACTION_LOCK_TIMEOUT=1s

# Kakao / Google OAuth / JWT
KAKAO_REST_API_KEY=replace-with-a-secret
KAKAO_CLIENT_SECRET=replace-with-a-secret
GOOGLE_CLIENT_ID=replace-with-a-client-id
GOOGLE_CLIENT_SECRET=replace-with-a-secret
JWT_SECRET_BASE64=replace-with-a-base64-encoded-32-byte-secret
BACKEND_BASE_URL=https://www.harudle.com
FRONTEND_ORIGIN=https://www.harudle.com
FRONTEND_SUCCESS_REDIRECT=https://www.harudle.com/auth/callback
FRONTEND_FAILURE_REDIRECT=https://www.harudle.com/auth/callback?error=oauth_failed
SESSION_COOKIE_SECURE=true
# APPLE_LOGIN_ENABLED=true인 환경에서는 none으로 설정합니다.
SESSION_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_SECURE=true

# Apple 로그인은 서버에 키 파일과 HTTPS 콜백을 준비한 뒤 활성화합니다.
APPLE_LOGIN_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# 호스트 /etc/harudle/secrets/apple/AuthKey.p8을 컨테이너에서 읽는 경로입니다.
APPLE_PRIVATE_KEY_PATH=/var/run/harudle/apple/AuthKey.p8

# Public feed URL (required when SPRING_PROFILES_ACTIVE=prod)
FEED_PUBLIC_BASE_URL=https://www.harudle.com/feeds

# Generation worker concurrency and poll interval (recreate the backend container after changes)
GENERATION_WORKER_CONCURRENCY=1
GENERATION_WORKER_POLL_INTERVAL=5s

# Generation lifecycle
GENERATION_PROCESSING_TIMEOUT=30m
GENERATION_CLEANUP_INTERVAL=1m
# 대기 작업의 제한 시간과 만료 확인 간격입니다.
GENERATION_PENDING_TIMEOUT=120s
GENERATION_PENDING_CLEANUP_INTERVAL=5s

# Generation prompt bootstrap
HARUDLE_GENERATION_PROMPT_BOOTSTRAP_ENABLED=false
HARUDLE_GENERATION_PROMPT_BOOTSTRAP_STORYBOARD_PROMPT_TEXT=
HARUDLE_GENERATION_PROMPT_BOOTSTRAP_IMAGE_STYLE_PROMPT_TEXT=

# Copy and verify this reference file before deploying the environment-specific key.
HARUDLE_GENERATION_PROMPT_BOOTSTRAP_IMAGE_ASSET_OBJECT_KEY=harudle/references/generation/prod/05-reference-style-asset.png

# External generation adapters
HARUDLE_GENERATION_ADAPTERS_ENABLED=false
# Gemini authentication: express (API Key) / vertex (project + ADC)
GEMINI_AUTH_MODE=express
GOOGLE_API_KEY=replace-with-a-secret
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Vertex WIF: credential configuration 파일을 아래 컨테이너 경로에 읽기 전용 마운트합니다.
# GOOGLE_APPLICATION_CREDENTIALS=/var/run/harudle/gcp-wif.json
GEMINI_STORYBOARD_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Nano Banana 2.1: vertex 모드와 global에서 위 모델 값을 gemini-nano-banana-2.1로 변경합니다.
GEMINI_STORYBOARD_THINKING_LEVEL=high
GEMINI_IMAGE_ASPECT_RATIO=1:1
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_RETRY_ATTEMPTS=3
GEMINI_REQUEST_TIMEOUT=180s

# EC2에서는 AWS Access Key를 넣지 않고 ec2-project IAM Role을 사용합니다.
AWS_REGION=ap-northeast-2
S3_BUCKET=techcourse-project-2026
S3_GENERATED_PREFIX=harudle/generated/diary-images/prod
S3_REFERENCE_PREFIX=harudle/references/generation/prod
S3_MAX_OBJECT_SIZE=20MB
S3_ACCESS_URL_TTL=15m

# R2 storage (disabled by default)
# Dev tests may use development credentials; keep production credentials out of dev.
R2_ENABLED=false
R2_ENDPOINT=
R2_BUCKET=harudle-backup
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCESS_URL_TTL=15m
R2_MAX_OBJECT_SIZE=20MB
R2_LIST_LOOKUP_BUDGET=2s
R2_SINGLE_LOOKUP_BUDGET=2s
# Automatic backup: enable only on prod after storage configuration is verified.
R2_BACKUP_SCHEDULER_ENABLED=false
R2_BACKUP_CRON=0 0 0 * * *
R2_BACKUP_ZONE=Asia/Seoul
R2_BACKUP_BATCH_SIZE=100

# 약관·프론트·기존 회원 안내 검토 후 환경별로 켠다. 백엔드 단독 배포에서는 false 유지.
LEGAL_REQUIRE_TERMS_ACCEPTANCE=false
